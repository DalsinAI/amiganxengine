; $VER: Install-NXEngine 2.6.5-1f093d1-amigaos3-test1 (3.11.2026)
; The Amiga Installer script for NXEngine-evo, an AmiCradle game port.
; Made by amicradle scripts/port_installer.py: change the spec, not this file.
; Run it from its icon, beside the NXEngine drawer where the archive was unpacked.

(set @app-name "NXEngine-evo")
(set #version "2.6.5-1f093d1-amigaos3-test1")
(set #drawer "NXEngine")
(set #program "nxengine-evo")
(set #space 5860)  ; KB

; the Installer runs this after an abort too: only a stop while copying needs it
(set #copying 0)
(onerror
    (if #copying
        (message (cat "NXEngine-evo was not installed completely." "\n\n" @error-msg
                      "\n\nFiles already copied stay where they are. Run Install-NXEngine again to finish."))))

; the Installer, the CPU and the FPU
(if (< @installer-version 2818051)
    (abort "NXEngine-evo needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "NXEngine-evo needs a 68040, 68060 or 68080 with an FPU. This Amiga has a " #cpu ".")))
(if (= (database "fpu") "NOFPU")
    (abort "NXEngine-evo needs a 68040, 68060 or 68080 with an FPU. This Amiga has no FPU."))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The NXEngine drawer is not beside Install-NXEngine. Unpack the whole archive, then run Install-NXEngine from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The NXEngine drawer has no nxengine-evo in it. Unpack the whole archive again."))

(welcome "This installs NXEngine-evo 2.6.5-1f093d1-amigaos3-test1 for AmigaOS 3.2 on a 68040, 68060 or 68080 with an FPU.")

; where: the parent drawer
(set #default
    (if (= (exists "Work:Games" (noreq)) 2) "Work:Games"
        (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:")))
(set #parent
    (askdir
        (prompt "Where should the NXEngine drawer go? Choose the drawer to put it in.")
        (help "The Installer makes or updates a drawer called NXEngine in the drawer you choose. An update keeps your saves and settings.")
        (default #default)))
(set #dest (tackon #parent #drawer))
(set #update (= (exists #dest (noreq)) 2))
; in KB where the Installer can say so: in bytes, 2 GB free and more does not fit
(set #free (if (>= @installer-version 2883584) (getdiskspace #parent "K")
    (/ (getdiskspace #parent) 1024)))
(if (and (>= #free 0) (< #free #space))
    (abort (cat "There is not enough room in " #parent ": NXEngine-evo needs 6 MB free.")))

; GFOpenGPU's modules: in LIBS:GFOpenGPU/, or copied there from LIBS:OpenGPU/
; (older instances have only that); none is copied before all are found
(if (and (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/SDL2.module" (noreq)) 1))
    (abort "NXEngine-evo needs GFOpenGPU's SDL2.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-NXEngine again. Nothing has been installed."))
(if (and (<> (exists "LIBS:GFOpenGPU/SDL2_mixer.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/SDL2_mixer.module" (noreq)) 1))
    (abort "NXEngine-evo needs GFOpenGPU's SDL2_mixer.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-NXEngine again. Nothing has been installed."))
(if (and (<> (exists "LIBS:GFOpenGPU/SDL2_image.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/SDL2_image.module" (noreq)) 1))
    (abort "NXEngine-evo needs GFOpenGPU's SDL2_image.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-NXEngine again. Nothing has been installed."))
(set #copying 1)
(if (<> (exists "LIBS:GFOpenGPU" (noreq)) 2)
    (makedir "LIBS:GFOpenGPU"))
(if (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1)
    (copyfiles
        (prompt "Copying SDL2.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copyfiles-help)
        (source "LIBS:OpenGPU")
        (dest "LIBS:GFOpenGPU")
        (choices "SDL2.module")))
(if (<> (exists "LIBS:GFOpenGPU/SDL2_mixer.module" (noreq)) 1)
    (copyfiles
        (prompt "Copying SDL2_mixer.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copyfiles-help)
        (source "LIBS:OpenGPU")
        (dest "LIBS:GFOpenGPU")
        (choices "SDL2_mixer.module")))
(if (<> (exists "LIBS:GFOpenGPU/SDL2_image.module" (noreq)) 1)
    (copyfiles
        (prompt "Copying SDL2_image.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copyfiles-help)
        (source "LIBS:OpenGPU")
        (dest "LIBS:GFOpenGPU")
        (choices "SDL2_image.module")))
(complete 20)

; the drawer: everything in it, but what the player has made
(set #copying 1)
(set #kept "")
(if (exists (tackon #dest "User") (noreq))
    (set #kept (if (= #kept "") "User" (cat #kept "|" "User"))))
(if (not #update)
    (makedir #dest))
(if (= #kept "")
    (copyfiles
        (prompt "Copying NXEngine-evo")
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (all)
        (optional "force" "askuser"))
    (copyfiles
        (prompt (cat "Updating NXEngine-evo. Kept as they are: " #kept))
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (pattern (cat "~(" #kept ")"))
        (optional "force" "askuser")))
(if (<> (exists (tackon #parent "NXEngine.info") (noreq)) 1)
    (copyfiles
        (help @copyfiles-help)
        (source #source)
        (dest #parent)
        (choices "NXEngine.info")))

(set @default-dest #dest)
(complete 100)
(if @pretend
    (message (cat "Pretend: nothing was copied or changed. NXEngine-evo would have gone in " #dest "."))
    (message (cat "NXEngine-evo 2.6.5-1f093d1-amigaos3-test1 is installed in " #dest "."
                  "\n\nTo start it, open the NXEngine drawer and double-click the nxengine-evo icon."
                  (if (= #kept "") "" (cat "\n\nLeft as they were: " #kept ".")))))
(exit (quiet))
