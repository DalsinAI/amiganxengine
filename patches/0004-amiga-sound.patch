diff --git a/src/sound/SoundManager.cpp b/src/sound/SoundManager.cpp
index d29b56e..e9b789e 100644
--- a/src/sound/SoundManager.cpp
+++ b/src/sound/SoundManager.cpp
@@ -17,6 +17,64 @@
 #define MUSIC_ON 1
 #define MUSIC_BOSS_ONLY 2
 
+#if defined(__amigaos__)
+static uint32_t amiga_buffer_ms;               // one buffer's play time, ms x 1000
+static volatile uint32_t amiga_buffers, amiga_late, amiga_last_tick, amiga_mixes;
+static volatile uint64_t amiga_mix_start, amiga_mix_total, amiga_mix_max;
+
+void amiga_audio_mix_start()
+{
+  amiga_mix_start = SDL_GetPerformanceCounter();
+}
+
+static void amiga_postmix(void *, Uint8 *, int)
+{
+  uint32_t now = SDL_GetTicks();
+  if (amiga_last_tick && (now - amiga_last_tick) * 1000 > amiga_buffer_ms * 3 / 2)
+    amiga_late = amiga_late + 1;
+  amiga_last_tick = now;
+  amiga_buffers   = amiga_buffers + 1;
+  if (amiga_mix_start)
+  {
+    uint64_t took = SDL_GetPerformanceCounter() - amiga_mix_start;
+    amiga_mix_start = 0;
+    amiga_mix_total = amiga_mix_total + took;
+    if (took > amiga_mix_max)
+      amiga_mix_max = took;
+    amiga_mixes = amiga_mixes + 1;
+  }
+}
+
+// the whole run's, for the summary at exit
+static uint32_t amiga_all_buffers, amiga_all_late, amiga_all_mixes, amiga_reports;
+static uint32_t amiga_report_low = 0xffffffff, amiga_report_high;
+static uint64_t amiga_all_mix_total, amiga_all_mix_max;
+
+void amiga_audio_report(double seconds)
+{
+  SDL_LockAudio();
+  uint32_t buffers = amiga_buffers, late = amiga_late, mixes = amiga_mixes;
+  uint64_t total = amiga_mix_total, most = amiga_mix_max;
+  amiga_buffers = amiga_late = amiga_mixes = 0;
+  amiga_mix_total = amiga_mix_max = 0;
+  SDL_UnlockAudio();
+  double freq = (double)SDL_GetPerformanceFrequency();
+  amiga_reports++;
+  amiga_all_buffers += buffers;
+  amiga_all_late += late;
+  amiga_all_mixes += mixes;
+  amiga_all_mix_total += total;
+  if (most > amiga_all_mix_max)
+    amiga_all_mix_max = most;
+  if (buffers < amiga_report_low)
+    amiga_report_low = buffers;
+  if (buffers > amiga_report_high)
+    amiga_report_high = buffers;
+  LOG_INFO("audio {} buffers in {:.2f} s, {} late; mixing {:.2f} ms a buffer on average, {:.2f} ms at most ({} with music)",
+           buffers, seconds, late, mixes ? total * 1000.0 / freq / mixes : 0.0, most * 1000.0 / freq, mixes);
+}
+#endif
+
 namespace NXE
