@@ -125,6 +198,16 @@ void SoundManager::shutdown()
   Organya::getInstance()->shutdown();
   Pixtone::getInstance()->shutdown();
 
+#if defined(__amigaos__)
+  Mix_SetPostMix(NULL, NULL);
