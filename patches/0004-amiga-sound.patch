+             SDL_GetCurrentAudioDriver() ? SDL_GetCurrentAudioDriver() : "none", freq, channels, format, samples,
+             amiga_buffer_ms / 1000.0, v->major, v->minor, v->patch);
+    Mix_SetPostMix(amiga_postmix, NULL);
