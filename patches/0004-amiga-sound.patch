+    LOG_INFO("audio summary: {} readings, {} buffers ({} to {} a reading), {} late; mixing {:.2f} ms a buffer on average, {:.2f} ms at most",
+             amiga_reports, amiga_all_buffers, amiga_report_low, amiga_report_high, amiga_all_late,
+             amiga_all_mixes ? amiga_all_mix_total * 1000.0 / freq / amiga_all_mixes : 0.0, amiga_all_mix_max * 1000.0 / freq);
