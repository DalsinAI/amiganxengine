+#if defined(__amigaos__)
+// AmigaOS: with -fps, each second's rate of frames shown goes to the log
+bool amiga_log_fps = false;
+static void amiga_fps_tick()
+{
+  static uint32_t start = 0, last = 0;
+  static int frames = 0;
+  uint32_t now = SDL_GetTicks();
+  if (!start)
+    start = last = now;
+  frames++;
+  if (now - last >= 1000)
+  {
+    LOG_INFO("fps {:.1f} at {:.3f} s", frames * 1000.0 / (now - last), (now - start) / 1000.0);
+    frames = 0;
+    last   = now;
+  }
+}
+#endif
+
