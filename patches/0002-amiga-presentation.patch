+#if defined(__amigaos__)
+// AmigaOS: with -fps, each second's rate of frames shown goes to the log,
+// and at exit how many readings, their average, the lowest and the highest
+bool amiga_log_fps = false;
+static int amiga_fps_readings = 0;
+static double amiga_fps_sum = 0, amiga_fps_low = 1e9, amiga_fps_high = 0;
+static void amiga_fps_tick()
+{
+  static uint32_t start = 0, last = 0;
+  static int frames = 0;
+  uint32_t now = SDL_GetTicks();
+  if (!start)
+    start = last = now;
+  frames++;
+  if (now - last >= 1000)
+  {
+    double rate = frames * 1000.0 / (now - last);
+    LOG_INFO("fps {:.1f} at {:.3f} s", rate, (now - start) / 1000.0);
+    amiga_fps_readings++;
+    amiga_fps_sum += rate;
+    if (rate < amiga_fps_low)
+      amiga_fps_low = rate;
+    if (rate > amiga_fps_high)
+      amiga_fps_high = rate;
+    frames = 0;
+    last   = now;
+  }
+}
+#endif
+
