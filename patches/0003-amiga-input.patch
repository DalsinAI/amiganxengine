+#if defined(__amigaos__)
+// AmigaOS: SetEnv NX_INPUT RAM:input.txt logs every key, joystick and pad
+// event the game takes, with its time
+static FILE *amiga_input_log = NULL;
+static void amiga_input_event(const char *what, int a, int b)
+{
+  if (!amiga_input_log)
+    return;
+  uint32_t t = SDL_GetTicks();
+  fprintf(amiga_input_log, "%u.%03u %s %d %d\n", (unsigned)(t / 1000), (unsigned)(t % 1000), what, a, b);
+  fflush(amiga_input_log);
+}
+#endif
